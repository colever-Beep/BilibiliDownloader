---
import BaseLayout from '../../layouts/BaseLayout.astro';
const releases = 'https://github.com/colever-Beep/BilibiliDownloader/releases';

const changes = [
  'UI 重构版（发行说明）：本版本采用 PySide6 + QFluentWidgets 重构整个 GUI 界面，相较上一采用 CustomTkinter 作为 UI 库的 1.0.0 版本更加流畅与现代化；现已提供 Windows / macOS / Linux 三平台安装包（由 GitHub Actions 自动构建并发布到 Releases）。',
  '统一分页与浏览器跳转：搜索 / 各列表复用分页逻辑，列表项新增「在浏览器中打开」跳转按钮。',
  '加载顺序优化：每周必看 / 排行榜改为先弹窗显示「加载中」再后台拉取，消除卡顿错觉。',
  '批量解析统一：UP 主空间等可翻页来源统一走分页选择框。',
  '跳页增强：分页栏显示「第 N / M 页」总页数，输入超范围自动钳制到末页。',
  '主题防抖：强调色 / 明暗切换加 140ms 防抖提交器，缓解拖动取色器造成的卡顿。',
  '项目更名：统一为 BilibiliDownloader（打包产物名、窗口标题、应用名一致）。',
  '许可证合规：补齐 GPL-3.0 的 LICENSE / NOTICE，明确衍生作品署名与许可。',
];

const changes212 = [
  '恢复完整版：v2.1.2 默认发布完整版，恢复「发现」分组（每周必看 / 排行榜 / 搜索 B站 / bilibili 音乐 / 直播中心）与「百宝箱」分组（自定义链接下载 / 今日人品 / 千万别点）。精简版保留在 slim 分支作为可选体验。',
  '修复更新检测失灵：稳定版改为按语义版本号取最高版本（不再受 GitHub Release 发布时间顺序影响），配合 normalize_version 四段式解析，v2.1.2 可被正确判定为比 v2.1.1.1 更新，内置更新检测可正常提示新版本。',
  '登录后温馨提示：每次登录成功（扫码 / Cookie 任一方式）后弹出温馨提示；标题为「欢迎，（用户名）!(*^@^*)」，正文首句为「欢迎使用bilibildownloader!」。',
  '修复触屏误选 / 番剧整季误下载：按住到释放的位移超过阈值时只滚动、不勾选；番剧 / 影视 / 课程 / 合集等多分集容器改为先解析分集并打开选集界面，默认零勾选、确认按钮在未选时禁用。',
];
---

<BaseLayout title="更新日志 - BilibiliDownloader" active="更新日志" prose={false}>
  <div class="container">
    <div class="doc">
      <div class="doc-hero">
        <h1>更新日志</h1>
        <p>近期重要变更汇总；完整版本记录请查看 GitHub Releases。</p>
      </div>

      <div class="changelog-list">
        <div class="rel-card">
          <div class="rel-head">
            <span class="rel-ver">v2.1.2</span>
            <span class="rel-tag">重要变更</span>
          </div>
          <ul class="rel-list">
            {changes212.map((c) => <li>{c}</li>)}
          </ul>
          <a class="rel-link" href={releases} target="_blank" rel="noopener">查看 GitHub Releases →</a>
        </div>
        <div class="rel-card">
          <div class="rel-head">
            <span class="rel-ver">v2.1.1.1</span>
            <span class="rel-tag">重要变更</span>
          </div>
          <ul class="rel-list">
            {changes.map((c) => <li>{c}</li>)}
          </ul>
          <a class="rel-link" href={releases} target="_blank" rel="noopener">查看 GitHub Releases →</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
