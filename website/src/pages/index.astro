---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import DownloadSection from '../components/DownloadSection.astro';

const groups = [
  {
    title: '解析与下载',
    items: [
      { name: '多类型解析', desc: '视频、番剧、直播、音频、歌单、收藏夹、UP 主、合集、课程一键解析下载。' },
      { name: '批量解析', desc: '一次粘贴多个链接，各来源分页选择框各自处理。' },
      { name: '直播录制', desc: '支持 B 站直播录制，实时保存为本地视频文件。' },
      { name: '自动归类', desc: '按视频种类自动分文件夹存放，下载路径整洁有序。' },
      { name: '浏览器跳转', desc: '列表项一键在浏览器打开对应页面（视频 / UP 主空间等）。' },
    ],
  },
  {
    title: '界面与体验',
    items: [
      { name: '统一分页选择', desc: '搜索 / 收藏夹 / 历史等列表统一分页弹窗，支持跳页与总页数显示。' },
      { name: '主题与强调色', desc: '明暗主题 + 可自定义强调色，切换做了防抖优化更顺滑。' },
      { name: '多语言', desc: '界面支持简体中文、繁体中文、English、日本語。' },
      { name: '高 DPI 适配', desc: '完美适配高分屏与不同缩放，界面元素清晰不模糊。' },
    ],
  },
];
---
<BaseLayout title="BilibiliDownloader — B 站内容下载器">
  <Hero />

  <section class="section">
    <div class="container">
      <h2 class="section-title">功能特性</h2>
      <p class="section-sub">一个工具，覆盖 B 站绝大多数内容类型的解析与下载。</p>
      <div class="feat-groups">
        {groups.map((g) => (
          <div class="feat-group">
            <h3 class="feat-group-title">{g.title}</h3>
            <ul class="feat-list">
              {g.items.map((it) => (
                <li><b>{it.name}</b><span>{it.desc}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <DownloadSection />
</BaseLayout>

<style>
  .feat-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 28px 44px; }
  .feat-group-title { font-size: 17px; margin: 0 0 12px; color: var(--text); }
  .feat-group-title::before {
    content: ''; display: inline-block; width: 6px; height: 16px;
    background: var(--accent); border-radius: 3px; margin-right: 8px; vertical-align: -2px;
  }
  .feat-list { list-style: none; margin: 0; padding: 0; }
  .feat-list li { padding: 9px 0; border-bottom: 1px solid var(--border); }
  .feat-list li:last-child { border-bottom: none; }
  .feat-list b { color: var(--text); font-weight: 600; }
  .feat-list span { display: block; color: var(--text-soft); font-size: 14px; margin-top: 2px; }
</style>
