---
const { title, desc, path } = Astro.props;
---
<div class="card">
  <span class="ico" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d={path} />
    </svg>
  </span>
  <h3>{title}</h3>
  <p>{desc}</p>
</div>
