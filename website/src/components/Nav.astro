---
const { active = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { href: base, label: '首页' },
  { href: base + 'docs', label: '使用文档' },
  { href: base + 'docs/faq', label: '常见问题' },
  { href: base + 'docs/changelog', label: '更新日志' },
  { href: 'https://github.com/colever-Beep/BilibiliDownloader/releases', label: '下载', external: true },
];
---
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={base}>
      <span class="logo">B</span> BilibiliDownloader
    </a>
    <nav class="nav-links">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['nav-link', { active: active === l.label }]}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener' : undefined}
        >{l.label}</a>
      ))}
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z" />
        </svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: var(--nav-h); }
  .brand { font-weight: 700; font-size: 18px; color: var(--text); display: flex; align-items: center; gap: 8px; }
  .brand:hover { text-decoration: none; }
  .logo { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: var(--accent); color: #fff; font-weight: 800; }
  .nav-links { display: flex; align-items: center; gap: 2px; flex-wrap: wrap; }
  .nav-link { padding: 8px 14px; border-radius: 8px; color: var(--text-soft); font-size: 15px; white-space: nowrap; }
  .nav-link:hover { background: var(--bg-soft); color: var(--text); text-decoration: none; }
  .nav-link.active { color: var(--accent); background: var(--accent-weak); }
  .theme-toggle {
    display: inline-grid; place-items: center; width: 38px; height: 38px; margin-left: 4px;
    border: 1px solid var(--border); border-radius: 9px; background: var(--bg-soft); color: var(--text-soft);
    cursor: pointer; transition: 0.15s;
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .theme-toggle svg { width: 18px; height: 18px; }
  @media (max-width: 560px) {
    .brand { font-size: 16px; }
    .nav-link { padding: 7px 9px; font-size: 14px; }
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  function sync() {
    if (btn) btn.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  }
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
    sync();
  });
  sync();
</script>
