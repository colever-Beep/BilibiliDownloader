---
const { active = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { href: base, label: '首页' },
  { href: base + '/docs', label: '使用文档' },
  { href: base + '/lite', label: '精简版' },
  { href: base + '/docs/faq', label: '常见问题' },
  { href: base + '/docs/changelog', label: '更新日志' },
  { href: 'https://github.com/colever-Beep/BilibiliDownloader/releases', label: '下载', external: true },
];
---
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={base}>
      <img class="logo" src={base + '/favicon.ico'} alt="BilibiliDownloader" width="28" height="28" /> BilibiliDownloader
    </a>
    <nav class="nav-links">
      {links.map((l) => (
        l.external
          ? <a class="nav-cta" href={l.href} target="_blank" rel="noopener">{l.label}</a>
          : <a
              href={l.href}
              class:list={['nav-link', { active: active === l.label }]}
            >{l.label}</a>
      ))}
      {/* WinUI 风格主题切换开关（ToggleSwitch） */}
      <div class="winui-switch" title="切换深色 / 浅色主题">
        <span class="switch-label">深色</span>
        <button id="theme-switch" class="switch" type="button" role="switch"
                aria-checked="false" aria-label="切换深色模式">
          <span class="switch-knob"></span>
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    /* WinUI Acrylic：半透明 + 背景模糊 */
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: var(--nav-h); }
  .brand { font-weight: 700; font-size: 18px; color: var(--text); display: flex; align-items: center; gap: 8px; }
  .brand:hover { text-decoration: none; }
  .logo { width: 28px; height: 28px; border-radius: 6px; object-fit: contain; }
  .nav-links { display: flex; align-items: center; gap: 2px; flex-wrap: wrap; }
  /* WinUI 导航药丸悬停 */
  .nav-link { padding: 8px 14px; border-radius: 8px; color: var(--text-soft); font-size: 15px; white-space: nowrap; transition: background .12s ease, color .12s ease; }
  .nav-link:hover { background: var(--bg-soft); color: var(--text); text-decoration: none; }
  .nav-link.active { color: var(--accent); background: var(--accent-weak); }
  /* 让开关与链接在视觉上对齐 */
  .winui-switch { margin-left: 6px; }
  @media (max-width: 620px) {
    .brand { font-size: 16px; }
    .nav-link { padding: 7px 9px; font-size: 14px; }
    .switch-label { display: none; }
  }
</style>

<script>
  const sw = document.getElementById('theme-switch');
  const root = document.documentElement;
  function render() {
    const dark = root.dataset.theme === 'dark';
    if (sw) sw.setAttribute('aria-checked', String(dark));
  }
  sw?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
    render();
  });
  render();
</script>
