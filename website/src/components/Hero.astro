---
const base = import.meta.env.BASE_URL;
---
<section class="hero">
  <div class="container hero-inner">
    <span class="badge">开源 · GPL-3.0 · Windows 10/11</span>
    <h1>BilibiliDownloader</h1>
    <p class="sub">B 站内容下载器 · 视频 / 番剧 / 直播 / 音频 一键解析</p>
    <div class="cta">
      <a class="btn primary" href="https://github.com/colever-Beep/BilibiliDownloader/releases" target="_blank" rel="noopener">下载最新版</a>
      <a class="btn ghost" href={base + 'docs'}>使用文档</a>
      <a class="btn ghost" href="https://github.com/colever-Beep/BilibiliDownloader" target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>
</section>

<style>
  .hero { padding: 64px 0 28px; text-align: center; }
  .badge {
    display: inline-block; padding: 4px 12px; border-radius: 999px;
    background: var(--accent-weak); color: var(--accent); font-size: 13px; font-weight: 600; margin-bottom: 18px;
  }
  .hero h1 { font-size: 44px; margin: 0 0 10px; letter-spacing: -0.5px; }
  .sub { font-size: 18px; color: var(--text-soft); margin: 0 0 24px; }
  .cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  @media (max-width: 600px) { .hero h1 { font-size: 34px; } }
</style>
