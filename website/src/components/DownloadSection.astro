---
const releases = 'https://github.com/colever-Beep/BilibiliDownloader/releases';
const platforms = [
  {
    name: 'Windows', note: 'Windows 10 / 11',
    icon: '<svg viewBox="0 0 22 22" fill="currentColor"><rect x="2" y="2" width="8" height="8" rx="1"/><rect x="12" y="2" width="8" height="8" rx="1"/><rect x="2" y="12" width="8" height="8" rx="1"/><rect x="12" y="12" width="8" height="8" rx="1"/></svg>',
    items: [
      { label: '安装版 (exe)', desc: '双击安装，带开始菜单与卸载入口' },
      { label: '便携版 (zip)', desc: '免安装，可放 U 盘随用随走' },
    ],
  },
  {
    name: 'macOS', note: 'Apple Silicon / Intel',
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 12.04c-.03-2.6 2.12-3.85 2.22-3.91-1.21-1.77-3.09-2.01-3.76-2.04-1.6-.16-3.12.94-3.93.94-.81 0-2.06-.92-3.39-.89-1.74.03-3.35 1.01-4.25 2.57-1.81 3.14-.46 7.79 1.3 10.34.86 1.25 1.88 2.65 3.22 2.6 1.29-.05 1.78-.83 3.34-.83 1.56 0 2 .83 3.37.81 1.39-.03 2.27-1.27 3.12-2.53.98-1.45 1.39-2.85 1.41-2.92-.03-.01-2.71-1.04-2.74-4.13zM14.6 4.84c.71-.86 1.19-2.06 1.06-3.25-1.02.04-2.26.68-2.99 1.54-.65.76-1.22 1.98-1.07 3.15 1.14.09 2.3-.58 3-1.44z"/></svg>',
    items: [
      { label: 'Apple Silicon (arm64)', desc: 'M 系列芯片 · .dmg / .app.zip' },
      { label: 'Intel (x86_64)', desc: '老款 Mac · .dmg / .app.zip' },
    ],
  },
  {
    name: 'Linux', note: 'x86_64 / ARM64',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3M12 15h5"/></svg>',
    items: [
      { label: 'AppImage (x86_64)', desc: '赋予执行权限后直接运行' },
      { label: 'AppImage (aarch64)', desc: '树莓派 / ARM 设备' },
    ],
  },
];
---
<section id="download" class="section alt">
  <div class="container">
    <h2 class="section-title">下载</h2>
    <p class="section-sub">所有平台安装包均在 GitHub Releases 发布，开源免费。</p>
    <div class="dl-groups">
      {platforms.map((p) => (
        <div class="winui-card dl-group">
          <h3 class="dl-name"><span class="dl-ico" set:html={p.icon} />{p.name} <small>{p.note}</small></h3>
          <ul class="dl-list">
            {p.items.map((it) => (
              <li><a href={releases} target="_blank" rel="noopener">{it.label}</a><span>{it.desc}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="dl-cta">
      <a class="btn primary" href={releases} target="_blank" rel="noopener">前往 GitHub Releases 下载</a>
    </p>
    <p class="note">
      首次运行会自动下载 FFmpeg（约数十 MB）；macOS 包未做 Apple 公证，首次打开请右键「打开」，
      或在终端执行 <code>xattr -d com.apple.quarantine /Applications/BilibiliDownloader.app</code>。
    </p>
  </div>
</section>

<style>
  .dl-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .dl-name { font-size: 17px; margin: 0 0 12px; color: var(--text); display: flex; align-items: center; gap: 8px; }
  .dl-ico { display: inline-flex; }
  .dl-ico svg { width: 22px; height: 22px; color: var(--accent); }
  .dl-name small { color: var(--text-soft); font-size: 13px; font-weight: 400; margin-left: 6px; }
  .dl-list { list-style: none; margin: 0; padding: 0; }
  .dl-list li { padding: 9px 0; border-bottom: 1px solid var(--border); }
  .dl-list li:last-child { border-bottom: none; }
  .dl-list a { font-weight: 600; }
  .dl-list a:hover { color: var(--accent); }
  .dl-list span { display: block; color: var(--text-soft); font-size: 13px; margin-top: 2px; }
  .dl-cta { text-align: center; margin-top: 28px; }
  .note { text-align: center; color: var(--text-soft); font-size: 13px; margin-top: 20px; line-height: 1.8; }
</style>
